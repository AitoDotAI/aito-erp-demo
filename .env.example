# Aito predictive database connection
# Get your credentials at https://aito.ai
#
# ─────────────────────────────────────────────────────────────────
# Single-tenant mode (default — one Aito DB serves the whole demo)
# ─────────────────────────────────────────────────────────────────
AITO_API_URL=https://your-instance.aito.app
AITO_API_KEY=your-api-key-here

# ─────────────────────────────────────────────────────────────────
# Multi-tenant mode (optional — one Aito DB per demo persona)
#
# When any of the per-tenant pairs below are set, the backend builds
# a separate AitoClient per persona and routes each request to the
# right DB based on the X-Tenant header sent by the frontend
# (driven by the TopBar profile switcher in the UI).
#
# Tenants that aren't configured fall back to the single-tenant
# AITO_API_URL / AITO_API_KEY above, so partial setups work too —
# you can spin up one persona at a time.
#
# ── Local-dev tip ────────────────────────────────────────────────
# For a local checkout, append `/env/dev` to each URL to point at
# an Aito environment branched from master. `./do env-init` creates
# the dev branches; `./do env-promote` swaps them into master when
# you're ready to ship. This keeps schema iteration off the live
# demo. See https://aito.ai/docs/api/envs/.
# ─────────────────────────────────────────────────────────────────

# Metsä Machinery Oy — industrial maintenance / construction persona
AITO_METSA_API_URL=https://shared.aito.ai/db/aito-erp-demo-2/env/dev
AITO_METSA_API_KEY=fca88879b65fb3d033a6ed980b7e12865fefce05c46d47cf16ad05976de797b8

# Aurora Retail Oy — multi-channel retail persona
AITO_AURORA_API_URL=https://shared.aito.ai/db/aito-erp-demo-3/env/dev
AITO_AURORA_API_KEY=e59cad0c6399154f517019cb5b8bd31c843d112b6690e2dc612e8d5c20ab1a0c

# Helsinki Studio — professional services persona
AITO_STUDIO_API_URL=https://shared.aito.ai/db/aito-erp-demo-4/env/dev
AITO_STUDIO_API_KEY=feb27ae1be447dfcb19bed0c7365eb8a10b910a4ec715775d80239304c950d81


# ─────────────────────────────────────────────────────────────────
# Aito API v2 (beta) — the rep2 engine
#
# v2 needs `collection` tables, which the live demo's rep1 tables are
# not, so it gets its own environment per tenant DB: a `v2` branch
# holding collection-shaped copies of the same fixtures. Same
# database, same key (keys are database-level and read every env) —
# only the `/env/` segment differs.
#
#   ./do env-init-v2     # branch `v2` from master on each tenant DB
#   ./do load-data-v2    # load the fixtures as collections
#   ./do v2-check        # report which view queries survive v2
#   ./do dev-v2          # run the demo against /api/v2
#
# AITO_API_VERSION selects the surface for the app itself. Leave it
# unset (or `v1`) in production — v2 is opt-in, per run.
# ─────────────────────────────────────────────────────────────────
AITO_API_VERSION=

AITO_METSA_V2_API_URL=https://shared.aito.ai/db/aito-erp-demo-2/env/v2
AITO_METSA_V2_API_KEY=fca88879b65fb3d033a6ed980b7e12865fefce05c46d47cf16ad05976de797b8

AITO_AURORA_V2_API_URL=https://shared.aito.ai/db/aito-erp-demo-3/env/v2
AITO_AURORA_V2_API_KEY=e59cad0c6399154f517019cb5b8bd31c843d112b6690e2dc612e8d5c20ab1a0c

AITO_STUDIO_V2_API_URL=https://shared.aito.ai/db/aito-erp-demo-4/env/v2
AITO_STUDIO_V2_API_KEY=feb27ae1be447dfcb19bed0c7365eb8a10b910a4ec715775d80239304c950d81


# ─────────────────────────────────────────────────────────────────
# Public-demo lockdown (set when deploying the demo to a public URL)
#
# PUBLIC_DEMO=1 enables:
#   - CORS lockdown to the origins listed in CORS_ORIGINS
#   - /api/tenants returns only ids (no raw Aito URLs)
#   - /api/schema returns 404
#   - tighter validation on submissions
#
# Rate-limit caps (per 60s window) are tunable too.
# ─────────────────────────────────────────────────────────────────
PUBLIC_DEMO=
CORS_ORIGINS=https://predictive-erp.aito.ai
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_TENANT=600
RATE_LIMIT_GLOBAL=1500
